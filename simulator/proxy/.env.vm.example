# The proxy against the self-hosted Hyperswitch on the VM (simulator/selfhost/README.md).
# Copy to .env (git-ignored). Comments stay on their own lines.
# Fill the HS_* lines from the VM's simulator/selfhost/state/proxy.env (made by seed.sh).
# Keep the STRIPE_* lines from your current .env: the Stripe test account is the same.

# The router listens on 127.0.0.1:8080 on the VM only. Open the tunnel first and keep it open:
#   gcloud compute ssh VM_NAME --zone ZONE -- -N -L 8090:127.0.0.1:8080
HS_BASE_URL=http://localhost:8090
# Our own engine, not the shared sandbox: texts say Rev Rec, and the contract test expects upstream main.
HS_ENGINE=selfhost
HS_API_KEY=
HS_PROFILE_ID=
HS_BILLING_MCA_ID=
HS_PAYMENT_MCA_ID=
HS_REVREC_MERCHANT_ID=
HS_MERCHANT_ID=
HS_ORG_ID=
# Signed by seed.sh with the router's JWT secret, for the merchant and profile above, so the proxy
# needs no switch. It expires after 30 days: run seed.sh again for a new one.
HS_DASHBOARD_JWT=

STRIPE_TEST_KEY=
STRIPE_CUSTOMER_ID=
STRIPE_PM_DECLINE=
STRIPE_PM_OK=

# Optional
PORT=8787
# HS_RECOVERY_PATH=v2/recovery
# RATE_LIMIT_STARTS_PER_HOUR=30
# SIM_PORTFOLIO=1
# Rev Rec retries within seconds here, so the portfolio form offers short caps (minutes).
PORTFOLIO_STOP_AFTER_MINUTES=1,3,7
# The sim service on the VM (simulator/selfhost/sim): simulated calendar, the model's decisions in plain
# numbers, the bank. Through the tunnel (-L 8093:127.0.0.1:8093); SIM_TOKEN is in the VM's .env.
SIM_URL=http://localhost:8093
SIM_TOKEN=
# Invoices per portfolio run (the form's slider goes up to this; default 10)
PORTFOLIO_MAX_INVOICES=25
# The simulator's own waits at that pace too: bank flips in seconds, a 15 s waiting note.
SIM_FAST_ENGINE=1
# The portfolio pair (HS_STATIC_* / HS_SMART_*) is not seeded on the VM: both runs use the profile above.
# Optional, from state/proxy.env after the seed (selfhost/README.md):
# The webhook inbox, through the tunnel (-L 8092:127.0.0.1:8092).
# INBOX_URL=http://localhost:8092
# INBOX_READ_TOKEN=
# Preset 9 on the decider profile (seed.sh 6c), and the stand-in decider's call log (-L 8094:127.0.0.1:8094).
# HS_DECIDER_PROFILE_ID=
# HS_DECIDER_BILLING_MCA_ID=
# HS_DECIDER_PAYMENT_MCA_ID=
# DECIDER_URL=http://localhost:8094
# Processors beyond Stripe (processors.ts): off unless listed (ids, comma separated, or "all"). Stripe
# only since 28 Oct; to turn them back on, also set HS_<PROCESSOR>_* and their keys.
# PROCESSORS_ENABLED=all
