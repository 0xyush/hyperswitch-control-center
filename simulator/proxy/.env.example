# Copy to .env (git-ignored) and fill in. Never commit real values.
HS_BASE_URL=https://sandbox.hyperswitch.io
HS_PROFILE_ID=
HS_API_KEY=
HS_BILLING_MCA_ID=
HS_PAYMENT_MCA_ID=
STRIPE_TEST_KEY=
STRIPE_CUSTOMER_ID=
STRIPE_PM_DECLINE=
STRIPE_PM_OK=

# Dashboard login for JWT-only reads (process tracker, profile config). M0: paste from the browser.
HS_MERCHANT_ID=
HS_DASHBOARD_JWT=

# Optional
PORT=8787
# HOST=127.0.0.1
# ALLOWED_ORIGINS=http://localhost:9000,http://127.0.0.1:9000
# HS_RECOVERY_PATH=v2/recovery
# RATE_LIMIT_STARTS_PER_HOUR=5
# PORTFOLIO_STOP_AFTER_MINUTES=10,20,45  # portfolio "stop after" choices; 0.5,1,2 on the self-hosted stack
# SIM_PASSWORD=                     # one shared password for the public link (empty = no gate)
# DASHBOARD_DIST=../../dist         # serve the dashboard build from the proxy (one origin)
# DASHBOARD_SERVER_DIR=../../src/server
# SIM_OPERATOR_KEY=                 # allows POST /sim/recordings/:id with header x-sim-operator
