# Copy to .env next to docker-compose.yml (git-ignored). Never commit real values.
# Comments stay on their own lines: docker compose reads this file.

# The Hyperswitch tag the images were built from (prepare.sh fetches the same tag's migrations).
HS_TAG=2026.10.26.0
# Cloud Build images: juspay/hyperswitch at HS_TAG, VERSION_FEATURE_SET=v2, BINARY=router / scheduler.
HS_ROUTER_IMAGE=us-central1-docker.pkg.dev/PROJECT/revrec-sim/ROUTER_IMAGE:TAG
HS_SCHEDULER_IMAGE=us-central1-docker.pkg.dev/PROJECT/revrec-sim/SCHEDULER_IMAGE:TAG

# Secrets. Make each one with the command above it.
# openssl rand -hex 24
HS_ADMIN_API_KEY=
# openssl rand -hex 32
HS_JWT_SECRET=
# openssl rand -hex 32   (64 hex characters; never change it after the first start: it encrypts merchant keys)
HS_MASTER_ENC_KEY=
# openssl rand -hex 32   (64 hex characters; a change makes every API key invalid)
HS_API_KEY_HASH_KEY=
# openssl rand -hex 24   (hex only: it goes into a database URL)
POSTGRES_PASSWORD=
# The Stripe TEST key (sk_test_...), the same as in simulator/proxy/.env. Only seed.sh uses it.
STRIPE_TEST_KEY=

# Webhooks to the inbox (docker-compose.yml webhook-inbox). The engine refuses private addresses,
# so the URL is the VM's external IP. Leave HS_WEBHOOK_URL empty to keep webhooks off.
# HS_WEBHOOK_URL=http://EXTERNAL_IP:8092/webhooks
HS_WEBHOOK_URL=
# openssl rand -hex 32   (the profile's payment_response_hash_key: the engine signs with it)
HS_WEBHOOK_HASH_KEY=
# openssl rand -hex 24   (the proxy sends it to read the inbox)
INBOX_READ_TOKEN=

# Optional, for seed.sh.
# RETRY_MODE=cascading
# LADDER_JSON='{"default_mapping":{"start_after":3,"frequencies":[[1,15]]}}'
# The sim service (docker compose --profile sim): the proxy's read token. Make one with: openssl rand -hex 24
SIM_TOKEN=
